<%- include('partials/head') %>
<%- include('partials/nav') %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "<%= post.title.replace(/"/g, '\\"') %>",
  "description": "<%= post.metaDescription.replace(/"/g, '\\"') %>",
  "image": "https://www.zenexio.pro/images/blog/<%= post.image %>",
  "datePublished": "<%= post.isoDate %>",
  "author": { "@type": "Organization", "name": "Zenexio" },
  "publisher": {
    "@type": "Organization",
    "name": "Zenexio",
    "logo": { "@type": "ImageObject", "url": "https://www.zenexio.pro/images/zen-wordmark.png" }
  },
  "mainEntityOfPage": "https://www.zenexio.pro/blogs/<%= post.slug %>"
}
</script>

<main>
  <section class="page-banner post-banner">
    <div class="page-banner__bg"></div>
    <div class="container">
      <div class="page-banner__content reveal">
        <span class="label"><%= post.tag %></span>
        <h1><%= post.title %></h1>
        <span class="blog-meta"><%= post.date %> &nbsp;&middot;&nbsp; <%= post.readTime %></span>
      </div>
    </div>
  </section>

  <section class="section post-section">
    <div class="container post-container">

      <div class="post-hero-img reveal" style="background-image:url('/images/blog/<%= post.image %>')"></div>

      <article class="post-body reveal" style="--d:.06s">
        <p class="post-lede"><%= post.excerpt %></p>
        <% post.body.forEach(block => { %>
          <% if (block.h2) { %>
            <h2><%= block.h2 %></h2>
          <% } else if (block.p) { %>
            <p><%= block.p %></p>
          <% } %>
        <% }) %>
      </article>

      <div class="post-cta reveal" style="--d:.1s">
        <span class="label">Like What You Read?</span>
        <h2>Let's put these ideas to work for your brand</h2>
        <a href="/contact" class="btn btn--gold btn--lg">Start a Project</a>
      </div>

      <% if (related && related.length) { %>
      <div class="post-related reveal" style="--d:.14s">
        <h3>More from the blog</h3>
        <div class="blog-grid">
          <% related.forEach(r => { %>
            <article class="blog-card">
              <a href="/blogs/<%= r.slug %>" class="blog-card__img" style="background:linear-gradient(to bottom,rgba(10,8,3,.15),rgba(10,8,3,.6)),url('/images/blog/<%= r.image %>');background-size:cover;background-position:center"><span class="blog-tag"><%= r.tag %></span></a>
              <div class="blog-card__body">
                <span class="blog-meta"><%= r.date %> &middot; <%= r.readTime %></span>
                <h3><a href="/blogs/<%= r.slug %>"><%= r.title %></a></h3>
                <a href="/blogs/<%= r.slug %>" class="blog-card__link">Read more &rarr;</a>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
      <% } %>

      <a href="/blogs" class="post-back reveal" style="--d:.18s">&larr; Back to all articles</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
