<%- include('partials/head') %>
<%- include('partials/nav') %>
<main>
  <section class="page-banner">
    <div class="page-banner__bg"></div>
    <div class="container">
      <div class="page-banner__content reveal">
        <span class="label">Who We Are</span>
        <h1>Built on Curiosity,<br>Driven by Craft</h1>
        <p>We're not just an agency — we're creative partners invested in your long-term success.</p>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section">
    <div class="container">
      <div class="story-grid">
        <div class="reveal">
          <span class="label">Our Story</span>
          <h2>Started small. Stayed intentional.</h2>
          <p>Zenexio was founded in 2017 by three restless creatives who believed most agencies had it backwards — prioritising flashy pitches over genuine partnership, and output over impact.</p>
          <p>We started in a shared workspace with three laptops and an unwavering belief: that truly great creative work happens when strategy, design, and technology speak the same language.</p>
          <p>Seven years later, we've delivered 500+ projects for clients across Dubai, UAE and India — and beyond. But our approach hasn't changed — every client gets our full attention, honest counsel, and work we're proud of.</p>
        </div>
        <div class="story-stat-block reveal" style="--d:.12s">
          <div class="sstat"><span class="sstat__num">2017</span><span class="sstat__lbl">Founded</span></div>
          <div class="sstat"><span class="sstat__num">500+</span><span class="sstat__lbl">Projects</span></div>
          <div class="sstat"><span class="sstat__num">2</span><span class="sstat__lbl">Countries</span></div>
          <div class="sstat"><span class="sstat__num">98%</span><span class="sstat__lbl">Retention</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="section section--sand" id="mission">
    <div class="container">
      <div class="mission-block reveal">
        <span class="label">Our Mission</span>
        <blockquote>"To build creative work that doesn't just look good — but works hard, solves real problems, and leaves a lasting impression on every person it reaches."</blockquote>
        <div class="mission-pillars">
          <div class="mission-pillar"><h4>Authenticity</h4><p>We only take on work we can do exceptionally. No stretched capacities, no recycled templates.</p></div>
          <div class="mission-pillar"><h4>Mastery</h4><p>Constant learning is non-negotiable. We invest in our craft because great work demands it.</p></div>
          <div class="mission-pillar"><h4>Impact</h4><p>We measure our worth by your results — not deliverable counts or invoice totals.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head reveal">
        <span class="label">What We Stand For</span>
        <h2>Values we live by</h2>
      </div>
      <div class="values-grid">
        <% const vals = [
          ['Radical Transparency', 'Hard conversations early beat crises late. We say what we see, always.'],
          ['Curiosity Without Ceiling', 'We stay genuinely curious — about your industry, new tools, better ways to solve old problems.'],
          ['Ownership Culture', 'Every person owns their piece fully. No blame-shifting, no "that\'s not my job."'],
          ['Long-Term Thinking', 'We optimise for your success over years. The best outcomes take root slowly.']
        ] %>
        <% vals.forEach((v,i) => { %>
        <div class="value-card reveal" style="--d:<%=i*0.07%>s">
          <span class="value-card__gem">◆</span>
          <div><h4><%=v[0]%></h4><p><%=v[1]%></p></div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="home-cta__inner reveal">
        <span class="label">Work With Us</span>
        <h2>We'd love to hear about your project</h2>
        <a href="/contact" class="btn btn--gold btn--lg" style="margin-top:1rem">Say Hello</a>
        <div class="trust-strip">
          <span><strong>500+</strong> Projects Delivered</span>
          <span class="trust-sep">·</span>
          <span><strong>98%</strong> Client Retention</span>
          <span class="trust-sep">·</span>
          <span>Dubai, UAE &amp; India</span>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
