<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <section class="page-banner">
    <div class="page-banner__bg"></div>
    <div class="container">
      <div class="page-banner__content reveal">
        <span class="label">Our Blog</span>
        <h1>Insights &amp; Ideas</h1>
        <p>Thoughts on design, technology, and the craft of building great brands.</p>
      </div>
    </div>
  </section>

  <section class="blogs-section section">
    <div class="container">

      <% const featured = posts[0]; const rest = posts.slice(1); %>

      <article class="blog-featured reveal">
        <a href="/blogs/<%= featured.slug %>" class="blog-featured__img">
          <div class="blog-featured__img-inner" style="background:linear-gradient(to bottom,rgba(10,8,3,.15),rgba(10,8,3,.6)),url('/images/blog/<%= featured.image %>');background-size:cover;background-position:center">
            <span class="blog-tag"><%= featured.tag %></span>
          </div>
        </a>
        <div class="blog-featured__body">
          <span class="blog-meta"><%= featured.date %> &nbsp;&middot;&nbsp; <%= featured.readTime %></span>
          <h2><a href="/blogs/<%= featured.slug %>"><%= featured.title %></a></h2>
          <p><%= featured.excerpt %></p>
          <a href="/blogs/<%= featured.slug %>" class="btn btn--gold">Read Article</a>
        </div>
      </article>

      <div class="blog-grid">
        <% rest.forEach((p, i) => { %>
        <article class="blog-card reveal" style="--d:<%= (i*0.06 + 0.06).toFixed(2) %>s">
          <a href="/blogs/<%= p.slug %>" class="blog-card__img" style="background:linear-gradient(to bottom,rgba(10,8,3,.15),rgba(10,8,3,.6)),url('/images/blog/<%= p.image %>');background-size:cover;background-position:center"><span class="blog-tag"><%= p.tag %></span></a>
          <div class="blog-card__body">
            <span class="blog-meta"><%= p.date %> &middot; <%= p.readTime %></span>
            <h3><a href="/blogs/<%= p.slug %>"><%= p.title %></a></h3>
            <p><%= p.excerpt %></p>
            <a href="/blogs/<%= p.slug %>" class="blog-card__link">Read more &rarr;</a>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
